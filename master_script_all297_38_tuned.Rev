# =============================================================================
# ALL-297 amphora tree, SRVF-38 PC — FIXED + TUNED rerun (convergence attempt).
# The 400k-gen run did not converge (ASDSF ~0.094). Changes: FBD_tuned.Rev
# (psi fixed, lambda/mu reparameterised, heavier topology moves) + more chains
# (8x3) + far more generations (2M). In-script mccTree removed (it OOM'd at
# teardown anyway); summarise with mcc_only_all297_38_tuned.Rev afterwards.
# Output simple_run_all297_38_tuned.*.
# =============================================================================
BASE = "amphora-phylogeny"
OUTPUT_DIR = BASE + "/output/simple_run_all297_38_tuned"

morpho <- readContinuousCharacterData(BASE + "/data/mini_character_all297_srvf_38.nex")
taxa   <- readTaxonData(BASE + "/data/mini_taxa_all297.tsv")

for (i in 1:taxa.size()) { ages[i] = taxa[i].getMaxAge() }
max_age = max(ages)

trait <- 1:38
morpho.excludeAll()
morpho.includeCharacter( trait )

moves = VectorMoves()

source(BASE + "/scripts/FBD_tuned.Rev")
source(BASE + "/scripts/strict_clock.Rev")
source(BASE + "/scripts/simple_BM.Rev")

mymodel = model(sigma2)

monitors = VectorMonitors()
monitors.append( mnModel(filename=(OUTPUT_DIR + ".log"), printgen=200) )
monitors.append( mnExtNewick(filename=(OUTPUT_DIR + ".trees"), isNodeParameter=TRUE,
                             printgen=200, separator=TAB, tree=fbd_tree) )
monitors.append( mnScreen(printgen=1000, sigma2, origin_time, diversification, turnover) )

mymcmcmc = mcmcmc(mymodel, monitors, moves, nchains=8, nruns=3, tuneHeat=TRUE, combine="mixed")
mymcmcmc.burnin(generations=50000, tuningInterval=200)
mymcmcmc.run(2000000)

q()
