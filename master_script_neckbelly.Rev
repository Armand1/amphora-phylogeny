# =============================================================================
# Three-clade amphora tree — SRVF (elastic) tangent-PCA characters, 121-taxon neck+belly amphora tree (+anchors), 38 tPCs. Blind: ALL neck + ALL belly.
# "Where does it stop" endpoint: 38 PCs = 100% of variance, but the dims beyond
# ~20 hold only ~0.12% (near-identical-pot noise). Expected: no within-class
# resolution gain, and sigma2 dragged toward its floor (one BM rate diluted over
# many noise characters, as in the 65-PC pilot).
#
# Parallel/additive config: separate charfile + output name so it can run
# concurrently with the 20-PC job without collision.
# =============================================================================
BASE = "amphora-phylogeny"
OUTPUT_DIR = BASE + "/output/simple_run_neckbelly"

morpho <- readContinuousCharacterData(BASE + "/data/mini_character_neckbelly_srvf_38.nex")
taxa   <- readTaxonData(BASE + "/data/mini_taxa_neckbelly.tsv")

for (i in 1:taxa.size()) { ages[i] = taxa[i].getMaxAge() }
max_age = max(ages)

trait <- 1:38
morpho.excludeAll()
morpho.includeCharacter( trait )

moves = VectorMoves()

source(BASE + "/scripts/FBD.Rev")
source(BASE + "/scripts/strict_clock.Rev")
source(BASE + "/scripts/simple_BM.Rev")

mymodel = model(sigma2)

monitors = VectorMonitors()
monitors.append( mnModel(filename=(OUTPUT_DIR + ".log"), printgen=10) )
monitors.append( mnExtNewick(filename=(OUTPUT_DIR + ".trees"), isNodeParameter=TRUE,
                             printgen=10, separator=TAB, tree=fbd_tree) )
monitors.append( mnScreen(printgen=100, sigma2, origin_time) )

mymcmcmc = mcmcmc(mymodel, monitors, moves, nchains=5, nruns=3, tuneHeat=TRUE, combine="mixed")
mymcmcmc.burnin(generations=10000, tuningInterval=100)
mymcmcmc.run(200000)

trace = readTreeTrace((OUTPUT_DIR + ".trees"))
mccTree(trace, file=(OUTPUT_DIR + "_mcc.tree"))

q()
