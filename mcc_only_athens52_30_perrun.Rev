# MCC for athens52_30 from the three per-run traces (works whether or not
# the run finished cleanly -- mcmcmc only writes the combined .trees on a clean
# finish, and a walltime kill leaves none).
BASE = "amphora-phylogeny"
OUTPUT_DIR = BASE + "/output/simple_run_athens52_30"
files = [OUTPUT_DIR + "_run_1.trees", OUTPUT_DIR + "_run_2.trees", OUTPUT_DIR + "_run_3.trees"]
trace = readTreeTrace(files, burnin=0.1, thinning=5)
mccTree(trace, file=(OUTPUT_DIR + "_mcc_perrun.tree"))
q()
