#!/bin/sh
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=25:mem=32gb
#PBS -N good238_76t

# GOOD-238 SRVF-76 fixed+tuned run. mcmcmc(8x3)=24 chains -> 25 ranks. 2M gens.
# Watch the first minute of the log for a move/parse error before walking away.
cd "$HOME/GitHub" || { echo "ERROR: cd $HOME/GitHub failed"; exit 1; }
mkdir -p "amphora-phylogeny/output"
LOGFILE="amphora-phylogeny/output/logfile_good238_76_tuned.log"
PROGRAM="$HOME/revbayes/projects/cmake/build-mpi/rb-mpi"
[ -x "$PROGRAM" ] || { echo "ERROR: RevBayes not found at $PROGRAM"; exit 1; }
SECONDS=0
echo "INFO:Starting        "`date`   > ${LOGFILE}
echo "INFO:Node Used       "`hostname` >> ${LOGFILE}
module load tools/dev; module load tools/prod; module load OpenMPI; module load GCC/14.3.0
mpirun -np 25 --map-by :OVERSUBSCRIBE ${PROGRAM} \
       "amphora-phylogeny/master_script_good238_76_tuned.Rev" >> ${LOGFILE} 2>&1
dur=$SECONDS
echo "INFO:Finishing       "`date`   >> ${LOGFILE}
echo "INFO:Time_Taken_(H:M:S) : $((dur/3600)):$(((dur%3600)/60)):$((dur%60))" >> ${LOGFILE}
