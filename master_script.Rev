# =============================================================================
# Three-clade amphora test tree  (pelike / loutrophoros / panathenaic,
# each spanning the Greece->Italy divide, rooted on deep geometric neck amphorae)
#
# Constant-rate FBD + strict clock + Brownian motion on 10 shape PCs.
# This is the TOPOLOGY+DATING run; relaxed branch rates are applied afterwards
# on the fixed topology (separate UCLN step, as for the pilot).
#
# Edit BASE for wherever this folder lives (local Mac or HPC).
# =============================================================================

# Path to this repo from wherever you launch rb. After `git clone` the folder is
# "amphora-phylogeny". Use "." if you first cd into the clone, or the full path
# (e.g. "GitHub/amphora-phylogeny") to launch from your HPC home.
BASE = "amphora-phylogeny"

OUTPUT_DIR = BASE + "/output/simple_run"

# --- data --------------------------------------------------------------------
morpho <- readContinuousCharacterData(BASE + "/data/mini_character.nex")
taxa   <- readTaxonData(BASE + "/data/mini_taxa.tsv")

for (i in 1:taxa.size()) { ages[i] = taxa[i].getMaxAge() }
max_age = max(ages)

# 20 PCs written to the .nex (99.9% of shape variance). Testing whether the extra
# characters buy within-class resolution (10-PC run left within-class nodes < 0.5).
trait <- 1:20
morpho.excludeAll()
morpho.includeCharacter( trait )

moves = VectorMoves()

# --- models ------------------------------------------------------------------
source(BASE + "/scripts/FBD.Rev")           # tree + dating
source(BASE + "/scripts/strict_clock.Rev")  # sigma2 (BM rate)
source(BASE + "/scripts/simple_BM.Rev")     # Brownian motion on the PCs

mymodel = model(sigma2)

# --- monitors ----------------------------------------------------------------
monitors = VectorMonitors()
monitors.append( mnModel(filename=(OUTPUT_DIR + ".log"), printgen=10) )
monitors.append( mnExtNewick(filename=(OUTPUT_DIR + ".trees"), isNodeParameter=TRUE,
                             printgen=10, separator=TAB, tree=fbd_tree) )
monitors.append( mnScreen(printgen=100, sigma2, origin_time) )

# --- run ---------------------------------------------------------------------
mymcmcmc = mcmcmc(mymodel, monitors, moves, nchains=5, nruns=3, tuneHeat=TRUE, combine="mixed")
mymcmcmc.burnin(generations=10000, tuningInterval=100)
mymcmcmc.run(100000)

# --- MCC tree ----------------------------------------------------------------
trace = readTreeTrace((OUTPUT_DIR + ".trees"))
mccTree(trace, file=(OUTPUT_DIR + "_mcc.tree"))

q()
