# Fossilised birth-death tree prior + tip-age uncertainty.
# Adapted from the pilot simple_model/scripts/FBD.Rev.

lambda <- ln(100)

# --- NOTE (flagged for Joel, not yet changed) --------------------------------
# psi ~ dnExponential(10000) has MEAN 1e-4 (dnExponential takes the RATE).
# The data imply psi ~ 0.006-0.04 (fossils / tree length), which this prior
# gives ~zero mass. Suspected cause of the psi posterior stalling near 0 and
# possibly the lambda=mu ridge. Candidate fix: dnExponential(100) (mean 0.01).
# Left at the pilot value for now so runs stay comparable.
psi ~ dnExponential(10000)
moves.append( mvScale(psi, lambda=0.1,  weight=1) )

speciation_rate ~ dnExponential(lambda)
moves.append( mvScale(speciation_rate, lambda = 0.1, weight=1) )

extinction_rate ~ dnExponential(lambda)
moves.append( mvScale(extinction_rate, lambda = 0.1, weight=1) )

rho <- 1.0

# --- Origin time -------------------------------------------------------------
# CEILING RAISED 3100 -> 4000. In the 65-PC pilot the root was jammed against
# the 3100 cap (97.5% = 3098) and the chronology broke. Our oldest tip is
# already 2990 BP, so the root needs room well above 3100.
origin_time ~ dnUnif(max_age, 4000)
moves.append( mvSlide(origin_time, delta=0.1,  weight=5.0) )

fbd_tree ~ dnFBDP(origin=origin_time, lambda=speciation_rate, mu=extinction_rate,
                  psi=psi, rho=rho, taxa=taxa)

moves.append( mvFNPR(fbd_tree, weight=15.0) )
moves.append( mvCollapseExpandFossilBranch(fbd_tree, origin_time, weight=6.0) )
moves.append( mvNodeTimeSlideUniform(fbd_tree, weight=40.0) )
moves.append( mvRootTimeSlideUniform(fbd_tree, origin_time, weight=5.0) )

# --- tip age uncertainty -----------------------------------------------------
fossils = fbd_tree.getFossils()
for (i in 1:fossils.size())
{
    t[i] := tmrca(fbd_tree, clade(fossils[i]))
    a_i = fossils[i].getMinAge()
    b_i = fossils[i].getMaxAge()
    F[i] ~ dnUniform(t[i] - b_i, t[i] - a_i)
    F[i].clamp(0)
}
moves.append( mvFossilTimeSlideUniform(fbd_tree, origin_time, weight=15.0) )
