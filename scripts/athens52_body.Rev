# =============================================================================
# Shared body for the Athens-52 demonstration tree. Caller sets NPC and TAG.
#
# 52 tips: the theta=0.25 abundance-first packing of 546 pooled tau=0.18 types
# built on the clean 5,358-pot Athens corpus. All 12 vessel classes, all 20
# date bins, -1050 to -100 BCE, 518 pots behind the tips.
#
# Purpose is a DEMONSTRATION: does a continuous-trait FBD on pot outlines give
# a well-resolved tree that an archaeologist recognises? At 52 tips this sits
# between the 39- and 77-taxon trees, both of which reached median node support
# 0.56-0.60 -- and unlike those, every pair of contemporaneous tips here is
# separated by more than the 0.122 measurement error.
# =============================================================================
BASE = "amphora-phylogeny"
OUTPUT_DIR = BASE + "/output/simple_run_" + TAG

morpho <- readContinuousCharacterData(BASE + "/data/athens52_char_" + NPC + ".nex")
taxa   <- readTaxonData(BASE + "/data/athens52_taxa.tsv")

for (i in 1:taxa.size()) { ages[i] = taxa[i].getMaxAge() }
max_age = max(ages)

trait <- 1:NPC
morpho.excludeAll()
morpho.includeCharacter( trait )

moves = VectorMoves()
source(BASE + "/scripts/FBD_tuned.Rev")
source(BASE + "/scripts/strict_clock_v2.Rev")   # sigma2 floor 1e-6, not 1e-3
source(BASE + "/scripts/simple_BM.Rev")

mymodel = model(sigma2)

monitors = VectorMonitors()
monitors.append( mnModel(filename=(OUTPUT_DIR + ".log"), printgen=100) )
monitors.append( mnExtNewick(filename=(OUTPUT_DIR + ".trees"), isNodeParameter=TRUE,
                             printgen=100, separator=TAB, tree=fbd_tree) )
monitors.append( mnScreen(printgen=2000, sigma2, origin_time, diversification, turnover) )

mymcmcmc = mcmcmc(mymodel, monitors, moves, nchains=8, nruns=3, tuneHeat=TRUE,
                  combine="mixed")
mymcmcmc.burnin(generations=20000, tuningInterval=200)
mymcmcmc.run(1000000)
q()
